@page "/gestion-usuarios"
@inject NavigationManager Navigation

<h1 class="page-title">Gestión de Usuarios</h1>

<div class="dashboard-grid">
    <div class="dashboard-card" @onclick="IrUsuarios">
        <div class="icon">👤</div>
        <div class="label">ABM Usuarios</div>
    </div>
    <div class="dashboard-card" @onclick="IrRoles">
        <div class="icon">👤👤👤</div>
        <div class="label">ABM Roles</div>
    </div>
</div>


@code {
    void IrUsuarios() => Navigation.NavigateTo("/usuarios");
    void IrRoles() => Navigation.NavigateTo("/roles");
}
