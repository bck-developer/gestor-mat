@page "/movimientos-material"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<h1 class="page-title">⬆️📦 Movimientos de Material</h1>

<!-- BOTONES DE ACCIÓN -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <button class="btn btn-primary btn-lg me-2" @onclick="IrCrear">
            ➕ Nuevo Movimiento
        </button>

        <button class="btn btn-secondary btn-lg" @onclick="Recargar">
            🔄 Recargar
        </button>
    </div>


</div>

<!-- SECCIÓN DE FILTROS -->
<div class="card mb-4 p-4 bg-light">
    <h5 class="mb-3">🔍 Filtros</h5>

        <!-- 🔎 BUSCADOR -->
    <div style="width:350px;">
        <input class="form-control form-control-lg"
               placeholder="🔎 Buscar..."
               @bind="textoBusqueda"
               @bind:event="oninput"
               @onkeydown="OnBuscarKeyDown" />
    </div>

    <!-- FILA 1: TIPO Y MATERIAL -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <label class="form-label">Tipo de Movimiento</label>
            <InputSelect class="form-control" @bind-Value="filtroTipo">
                <option value="">Todos los tipos</option>
                <option>Ingreso</option>
                <option>Egreso</option>
                <option>Ingreso/Egreso</option>
            </InputSelect>

            <label class="form-label">Material</label>
            <InputSelect class="form-control" @bind-Value="filtroMaterialId">
                <option value="0">Todos los materiales</option>
                @foreach (MaterialDto m in materiales)
                {
                    <option value="@m.Id_Material">@m.CodigoMaterial - @m.Nombre</option>
                }
            </InputSelect>
        </div>
    </div>

    <!-- FILA 2: FECHAS -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <label class="form-label">Desde (Fecha)</label>
            <InputDate class="form-control form-control-lg" @bind-Value="fechaDesde" />
        </div>

        <div class="col-md-5">
            <label class="form-label">Hasta (Fecha)</label>
            <InputDate class="form-control form-control-lg" @bind-Value="fechaHasta" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <div class="w-100">
                <button class="btn btn-primary w-100 btn-lg" @onclick="AplicarFiltros">
                    🔎 Filtrar
                </button>
            </div>
        </div>
        <!-- BOTÓN LIMPIAR -->
        <div class="row">
            <div class="col-12">
                <button class="btn btn-outline-secondary btn-lg w-100" @onclick="LimpiarFiltros">
                    ✕ Limpiar Filtros
                </button>
            </div>
        </div>
    </div>



</div>

<!-- TABLA DE RESULTADOS -->
@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (listaFiltrada.Count == 0)
{
    <div class="alert alert-info">No hay resultados</div>
}
else
{
    <table class="table table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Material</th>
                <th>Tipo</th>
                <th>Dep. Origen</th>
                <th>Dep. Destino</th>
                <th>Cantidad</th>
                <th>Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (MovimientoMaterialDto m in listaPaginada)
            {
                <tr @ondblclick="() => AbrirDetalle(m.Id_MovimientoMaterial)" style="cursor:pointer">
                    <td>@m.CodigoMovimiento</td>
                    <td>@ObtenerCodigoMaterial(m.Id_Material)</td>
                    <td>@m.Tipo</td>
                    <td>@ObtenerCodigoDeposito(m.Id_DepositoOrigen)</td>
                    <td>@ObtenerCodigoDepositoNullable(m.Id_DepositoDestino)</td>
                    <td>@m.Cantidad</td>
                    <td>@m.Fecha.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4 text-center">
        <button class="btn btn-secondary btn-sm me-2"
                @onclick="PaginaAnterior"
                disabled="@(paginaActual == 1)">
            ⬅ Anterior
        </button>

        <span class="badge bg-primary p-2">Página @paginaActual de @totalPaginas</span>

        <button class="btn btn-secondary btn-sm ms-2"
                @onclick="PaginaSiguiente"
                disabled="@(paginaActual == totalPaginas)">
            Siguiente ➡
        </button>
    </div>
}

@code {

    private List<MovimientoMaterialDto> lista = new List<MovimientoMaterialDto>();
    private List<MovimientoMaterialDto> listaFiltrada = new List<MovimientoMaterialDto>();
    private List<MovimientoMaterialDto> listaPaginada = new List<MovimientoMaterialDto>();

    private List<MaterialDto> materiales = new List<MaterialDto>();
    private List<DepositoDto> depositos = new List<DepositoDto>();

    private bool cargando = true;
    private string error = string.Empty;

    private int paginaActual = 1;
    private int tamanioPagina = 10;
    private int totalPaginas = 1;

    private string filtroTipo = string.Empty;
    private int filtroMaterialId = 0;
    private DateTime? fechaDesde = null;
    private DateTime? fechaHasta = null;

    private string textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Recargar();
    }

    private async Task Recargar()
    {
        cargando = true;
        error = string.Empty;

        try
        {
            HttpClient client = await AuthHttpClient.GetClient();

            lista = await client.GetFromJsonAsync<List<MovimientoMaterialDto>>("api/movimientos")
                ?? new List<MovimientoMaterialDto>();

            materiales = await client.GetFromJsonAsync<List<MaterialDto>>("api/material")
                ?? new List<MaterialDto>();

            depositos = await client.GetFromJsonAsync<List<DepositoDto>>("api/deposito")
                ?? new List<DepositoDto>();

            AplicarFiltros();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirDetalle(int id)
    {
        Navigation.NavigateTo($"/consultar-movimiento/{id}");
    }

    private void OnBuscarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AplicarFiltros();
        }
    }

    private void AplicarFiltros()
    {
        IEnumerable<MovimientoMaterialDto> query = lista;

        if (!string.IsNullOrEmpty(filtroTipo))
            query = query.Where(m => m.Tipo == filtroTipo);

        if (filtroMaterialId != 0)
            query = query.Where(m => m.Id_Material == filtroMaterialId);

        if (fechaDesde.HasValue)
            query = query.Where(m => m.Fecha.Date >= fechaDesde.Value.Date);

        if (fechaHasta.HasValue)
            query = query.Where(m => m.Fecha.Date <= fechaHasta.Value.Date);

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            string texto = textoBusqueda.ToLower();

            query = query.Where(m =>
                m.CodigoMovimiento.ToLower().Contains(texto) ||
                ObtenerCodigoMaterial(m.Id_Material).ToLower().Contains(texto) ||
                ObtenerCodigoDeposito(m.Id_DepositoOrigen).ToLower().Contains(texto) ||
                ObtenerCodigoDepositoNullable(m.Id_DepositoDestino).ToLower().Contains(texto)
            );
        }

        listaFiltrada = query.ToList();

        paginaActual = 1;
        CalcularPaginacion();
    }

    private void LimpiarFiltros()
    {
        filtroTipo = string.Empty;
        filtroMaterialId = 0;
        fechaDesde = null;
        fechaHasta = null;
        textoBusqueda = string.Empty;

        AplicarFiltros();
    }

    private void CalcularPaginacion()
    {
        totalPaginas = (int)Math.Ceiling((double)listaFiltrada.Count / tamanioPagina);
        if (totalPaginas == 0) totalPaginas = 1;

        listaPaginada = listaFiltrada
            .Skip((paginaActual - 1) * tamanioPagina)
            .Take(tamanioPagina)
            .ToList();
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            CalcularPaginacion();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            CalcularPaginacion();
        }
    }

    private string ObtenerCodigoMaterial(int id)
    {
        MaterialDto? m = materiales.FirstOrDefault(x => x.Id_Material == id);
        if (m == null) return "-";
        return string.IsNullOrEmpty(m.CodigoMaterial) ? m.Nombre : m.CodigoMaterial;
    }

    private string ObtenerCodigoDeposito(int id)
    {
        DepositoDto? d = depositos.FirstOrDefault(x => x.Id_Deposito == id);
        if (d == null) return "-";
        return d.CodigoDeposito;
    }

    private string ObtenerCodigoDepositoNullable(int? id)
    {
        if (!id.HasValue) return "-";
        return ObtenerCodigoDeposito(id.Value);
    }

    private void IrCrear()
    {
        Navigation.NavigateTo("/crear-movimiento");
    }

    public class MovimientoMaterialDto
    {
        public int Id_MovimientoMaterial { get; set; }
        public string CodigoMovimiento { get; set; } = string.Empty;
        public string Tipo { get; set; } = string.Empty;
        public double Cantidad { get; set; }
        public DateTime Fecha { get; set; }

        public int Id_Material { get; set; }
        public int Id_DepositoOrigen { get; set; }
        public int? Id_DepositoDestino { get; set; }
    }

    public class MaterialDto
    {
        public int Id_Material { get; set; }
        public string CodigoMaterial { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }

    public class DepositoDto
    {
        public int Id_Deposito { get; set; }
        public string CodigoDeposito { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }
}
