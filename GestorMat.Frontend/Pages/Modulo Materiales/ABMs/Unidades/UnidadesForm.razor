@page "/crear-unidad"
@page "/editar-unidad/{Id:int}"
@using GestorMat.Frontend.Pages.Modulo_Materiales.Unidades

@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation

<h1 class="page-title">@(Id == 0 ? "Crear Unidad de Medida" : "Editar Unidad de Medida")</h1>

@if (cargando)
{
    <div class="loading">
        <p>Cargando...</p>
    </div>
}
else
{
    <div class="form-container">
        <div class="card">
            <div class="card-body">

                <EditForm Model="modelo" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- NOMBRE -->
                    <div class="form-group">
                        <label for="nombre">Nombre:</label>
                        <InputText id="nombre" class="form-control" @bind-Value="modelo.Nombre" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="text-danger" />
                    </div>

                    <!-- ABREVIATURA -->
                    <div class="form-group">
                        <label for="abreviatura">Abreviatura:</label>
                        <InputText id="abreviatura" class="form-control"
                                   @bind-Value="modelo.Abreviatura" maxlength="10" />
                        <ValidationMessage For="@(() => modelo.Abreviatura)" class="text-danger" />
                    </div>

                    <!-- ACTIVO -->
                    <div class="form-group">
                        <label>
                            <InputCheckbox @bind-Value="modelo.Activo" />
                            Activo
                        </label>
                    </div>

                    <!-- BOTONES -->
                    <div class="button-group mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>💾 @(Id == 0 ? "Crear" : "Actualizar")</span>
                            }
                        </button>

                        <button type="button" class="btn btn-secondary" @onclick="Volver">
                            ⬅️ Volver
                        </button>
                    </div>

                    <!-- MENSAJES -->
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger mt-3">
                            @error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(exito))
                    {
                        <div class="alert alert-success mt-3">
                            @exito
                        </div>
                    }

                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CrearUnidadMedidaDto modelo = new();
    private bool cargando = false;
    private bool guardando = false;

    private string error = string.Empty;
    private string exito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            cargando = true;

            try
            {
                var client = await AuthHttpClient.GetClient();

                var unidad = await client.GetFromJsonAsync<UnidadMedidaDto>($"api/unidadmedida/{Id}");

                if (unidad != null)
                {
                    modelo = new CrearUnidadMedidaDto
                    {
                        Nombre = unidad.Nombre,
                        Abreviatura = unidad.Abreviatura,
                        Activo = unidad.Activo
                    };
                }
                else
                {
                    error = "Unidad no encontrada";
                }
            }
            catch (Exception ex)
            {
                error = $"Error al cargar la unidad: {ex.Message}";
            }
            finally
            {
                cargando = false;
            }
        }
    }

    private async Task Guardar()
    {
        if (guardando) return;

        guardando = true;
        error = string.Empty;
        exito = string.Empty;

        try
        {
            var client = await AuthHttpClient.GetClient();
            HttpResponseMessage response;

            if (Id == 0)
                response = await client.PostAsJsonAsync("api/unidadmedida", modelo);
            else
                response = await client.PutAsJsonAsync($"api/unidadmedida/{Id}", modelo);

            if (!response.IsSuccessStatusCode)
            {
                var contenido = await response.Content.ReadAsStringAsync();

                try
                {
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(contenido);
                    error = errorObj?["mensaje"]?.ToString() ?? "Error inesperado";
                }
                catch
                {
                    error = contenido;
                }

                return;
            }

            exito = Id == 0
                ? "Unidad creada correctamente"
                : "Unidad actualizada correctamente";

            await Task.Delay(1200);
            Navigation.NavigateTo("/unidades");
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/unidades");
    }
}
