@page "/depositos"
@inject DepositoService DepositoService
@inject NavigationManager Navigation

<h1 class="page-title">Depositos</h1>

<div class="button-group mb-3">
    <button class="btn btn-primary" @onclick="IrCrear">
        <span class="icon">➕</span> Nuevo Depósito
    </button>
    <button class="btn btn-secondary" @onclick="Recargar">
        <span class="icon">🔄</span> Recargar
    </button>
</div>

@if (cargando)
{
    <div class="loading">
        <p>Cargando depósitos...</p>
    </div>
}
else if (string.IsNullOrEmpty(error))
{
    @if (depositos != null && depositos.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DepositoDto deposito in depositos)
                    {
                        <tr>
                            <td>@deposito.CodigoDeposito</td>
                            <td>@deposito.Nombre</td>
                            <td>@deposito.Direccion</td>
                            <td>
                                <span class="badge @(deposito.Habilitado ? "badge-success" : "badge-danger")">
                                    @(deposito.Habilitado ? "Habilitado" : "Deshabilitado")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons-inline">
                                    <button class="btn btn-sm btn-warning" @onclick="() => IrEditar(deposito.Id_Deposito)" title="Editar depósito">
                                        ✏️ Editar
                                    </button>
                                    @if (deposito.Habilitado)
                                    {
                                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarInhabilitar(deposito.Id_Deposito, deposito.Nombre)" title="Inhabilitar acceso">
                                            🔒 Inhabilitar
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => Habilitar(deposito.Id_Deposito)" title="Habilitar acceso">
                                            🔓 Habilitar
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-danger btn-outline" @onclick="() => ConfirmarEliminar(deposito.Id_Deposito, deposito.Nombre)" title="Eliminar definitivamente">
                                        🗑️ Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p>No hay depósitos registrados. <a href="/crear-deposito">Crea uno aquí</a></p>
        </div>
    }
}
else
{
    <div class="alert alert-danger" role="alert">
        <p>@error</p>
        <button class="btn btn-secondary" @onclick="Recargar">Reintentar</button>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h5>Confirmar Acción</h5>
                <button type="button" class="close" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p>@mensajeConfirmacion</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                <button class="btn btn-danger" @onclick="ConfirmarAccion">Confirmar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DepositoDto>? depositos;
    private bool cargando = true;
    private string error = string.Empty;
    private bool mostrarConfirmacion = false;
    private int depositoAActualizarId;
    private string depositoAActualizarNombre = string.Empty;
    private string mensajeConfirmacion = string.Empty;
    private string accionPendiente = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Recargar();
    }

    private async Task Recargar()
    {
        cargando = true;
        error = string.Empty;
        depositos = null;

        try
        {
            depositos = await DepositoService.ObtenerDepositos();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar depósitos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrCrear()
    {
        Navigation.NavigateTo("/crear-deposito");
    }

    private void IrEditar(int id)
    {
        Navigation.NavigateTo($"/editar-deposito/{id}");
    }

    private void ConfirmarEliminar(int id, string nombre)
    {
        depositoAActualizarId = id;
        depositoAActualizarNombre = nombre;
        mensajeConfirmacion = $"¿Estás seguro de que deseas eliminar el depósito \"{nombre}\"? Esta acción es irreversible.";
        accionPendiente = "eliminar";
        mostrarConfirmacion = true;
    }

    private void ConfirmarInhabilitar(int id, string nombre)
    {
        depositoAActualizarId = id;
        depositoAActualizarNombre = nombre;
        mensajeConfirmacion = $"¿Estás seguro de que deseas inhabilitar el depósito \"{nombre}\"?";
        accionPendiente = "inhabilitar";
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarAccion()
    {
        try
        {
            if (accionPendiente == "eliminar")
            {
                await DepositoService.EliminarDeposito(depositoAActualizarId);
            }
            else if (accionPendiente == "inhabilitar")
            {
                await DepositoService.InhabilitarDeposito(depositoAActualizarId);
            }

            mostrarConfirmacion = false;
            await Recargar();
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private async Task Habilitar(int id)
    {
        try
        {
            await DepositoService.HabilitarDeposito(id);
            await Recargar();
        }
        catch (Exception ex)
        {
            error = $"Error al habilitar depósito: {ex.Message}";
        }
    }
}
