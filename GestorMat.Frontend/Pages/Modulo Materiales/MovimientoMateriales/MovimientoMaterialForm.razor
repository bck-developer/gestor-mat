@code {

    [Parameter]
    public int Id { get; set; }

    private MovimientoMaterialDto modelo = new MovimientoMaterialDto();
    private EditContext editContext;

    private List<MaterialDto> materiales = new List<MaterialDto>();
    private List<DepositoDto> depositos = new List<DepositoDto>();

    private bool usaOrigen = true;
    private bool usaDestino = false;
    private bool formValido = false;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        HttpClient client = await AuthHttpClient.GetClient();

        materiales = await client.GetFromJsonAsync<List<MaterialDto>>("api/material")
            ?? new List<MaterialDto>();

        depositos = await client.GetFromJsonAsync<List<DepositoDto>>("api/deposito")
            ?? new List<DepositoDto>();

        if (Id != 0)
        {
            modelo = await client.GetFromJsonAsync<MovimientoMaterialDto>($"api/movimientos/{Id}")
                ?? new MovimientoMaterialDto();
        }
        else
        {
            modelo.Fecha = DateTime.Today;
            modelo.Tipo = "Ingreso";
        }

        AjustarComportamientoPorTipo();
        Configurar();

        cargando = false;
    }

    private void Configurar()
    {
        editContext = new EditContext(modelo);

        editContext.OnFieldChanged += (_, __) =>
        {
            Validar();
        };

        Validar();
    }

    private void Validar()
    {
        bool depositoValido = true;

        if (modelo.Tipo == "Ingreso")
        {
            depositoValido = modelo.Id_DepositoOrigen > 0;
        }
        else if (modelo.Tipo == "Egreso")
        {
            depositoValido = modelo.Id_DepositoOrigen > 0;
        }
        else if (modelo.Tipo == "Ingreso/Egreso")
        {
            depositoValido =
                modelo.Id_DepositoOrigen > 0 &&
                modelo.Id_DepositoDestino.HasValue &&
                modelo.Id_DepositoDestino.Value > 0;
        }

        formValido =
            modelo.Id_Material > 0 &&
            modelo.Cantidad > 0 &&
            depositoValido;

        StateHasChanged();
    }

    private void OnTipoChange(ChangeEventArgs e)
    {
        modelo.Tipo = e.Value?.ToString() ?? "Ingreso";

        AjustarComportamientoPorTipo();

        Validar();
    }

    private void AjustarComportamientoPorTipo()
    {
        usaDestino = modelo.Tipo == "Ingreso/Egreso";

        if (!usaDestino)
        {
            modelo.Id_DepositoDestino = null;
        }
    }

    private async Task Guardar()
    {
        if (!formValido)
            return;

        HttpClient client = await AuthHttpClient.GetClient();

        CrearMovimientoMaterialDto modeloCreacion = new CrearMovimientoMaterialDto
        {
            IdMaterial = modelo.Id_Material,
            IdDepositoOrigen = modelo.Id_DepositoOrigen,
            IdDepositoDestino = modelo.Id_DepositoDestino ?? null,
            Tipo = modelo.Tipo,
            Cantidad = modelo.Cantidad,
            Fecha = modelo.Fecha,
            CodigoMovimiento = modelo.CodigoMovimiento,
            UserName = await ObtenerUsuarioActual()
        };

        await client.PostAsJsonAsync("api/movimientos", modeloCreacion);

        await JS.InvokeVoidAsync("alert",
            $"Movimiento {modelo.CodigoMovimiento} creado");

        Navigation.NavigateTo("/movimientos-material");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/movimientos-material");
    }

    private async Task<string> ObtenerUsuarioActual()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            string? username =
                user.FindFirst("unique_name")?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value;

            return username ?? string.Empty;
        }

        return string.Empty;
    }


    public class CrearMovimientoMaterialDto
    {
        public int IdMaterial { get; set; }
        public int IdDepositoOrigen { get; set; }
        public int? IdDepositoDestino { get; set; }
        [Required(ErrorMessage = "El tipo es obligatorio")]
        public string Tipo { get; set; } = string.Empty;
        [Required(ErrorMessage = "La cantidad es obligatoria")]
        public double Cantidad { get; set; }
        [Required(ErrorMessage = "La fecha es obligatoria")]
        public DateTime Fecha { get; set; }
        [Required(ErrorMessage = "El código de movimiento es obligatorio")]
        public string CodigoMovimiento { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }

    public class MovimientoMaterialDto
    {
        public int Id_MovimientoMaterial { get; set; }
        public string CodigoMovimiento { get; set; } = string.Empty;
        public string Tipo { get; set; } = string.Empty;
        public double Cantidad { get; set; }
        public DateTime Fecha { get; set; }
        public int Id_Material { get; set; }
        public int Id_DepositoOrigen { get; set; }
        public int? Id_DepositoDestino { get; set; }
    }

    public class MaterialDto
    {
        public int Id_Material { get; set; }
        public string CodigoMaterial { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }

    public class DepositoDto
    {
        public int Id_Deposito { get; set; }
        public string CodigoDeposito { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }
}
