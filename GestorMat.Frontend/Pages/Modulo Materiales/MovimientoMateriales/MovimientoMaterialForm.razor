@page "/crear-movimiento"
@page "/consultar-movimiento/{Id:int}"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<h1 class="page-title">
    @(Id == 0 ? "➕ Nuevo Movimiento" : "👁️ Ver Movimiento")
</h1>

@if (cargando)
{
    <p>Cargando...</p>
}
else
{
    <EditForm EditContext="editContext" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <!-- CODIGO -->
        <div class="mb-3">
            <label>Código *</label>
            <InputText class="form-control"
                       @bind-Value="modelo.CodigoMovimiento"
                       disabled="@(Id != 0)" />
            <ValidationMessage For="@(() => modelo.CodigoMovimiento)" />
        </div>

        <!-- MATERIAL -->
        <div class="mb-3">
            <label>Material *</label>
            <InputSelect class="form-control"
                         @bind-Value="modelo.Id_Material"
                         disabled="@(Id != 0)">
                <option value="0">Seleccionar</option>
                @foreach (MaterialDto m in materiales)
                {
                    <option value="@m.Id_Material">@m.CodigoMaterial</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => modelo.Id_Material)" />
        </div>

        <!-- TIPO -->
        <div class="mb-3">
            <label>Tipo *</label>
            <InputSelect class="form-control"
                         @bind-Value="TipoSeleccionado"
                         disabled="@(Id != 0)">
                <option value="">Seleccionar</option>
                <option value="Ingreso">Ingreso</option>
                <option value="Egreso">Egreso</option>
                <option value="Ingreso/Egreso">Ingreso/Egreso</option>
            </InputSelect>
            <ValidationMessage For="@(() => modelo.Tipo)" />
        </div>

        <!-- ORIGEN -->
        <div class="mb-3">
            <label>Depósito Origen *</label>
            <InputSelect class="form-control"
                         @bind-Value="modelo.Id_DepositoOrigen"
                         disabled="@(Id != 0)">
                <option value="0">Seleccionar</option>
                @foreach (DepositoDto d in depositos)
                {
                    <option value="@d.Id_Deposito">@d.CodigoDeposito</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => modelo.Id_DepositoOrigen)" />
        </div>

        <!-- DESTINO -->
        <div class="mb-3">
            <label>Depósito Destino @(usaDestino ? "*" : "")</label>
            <InputSelect class="form-control"
                         @bind-Value="modelo.Id_DepositoDestino"
                         disabled="@(!(usaDestino && Id == 0))">
                <option value="0">Seleccionar</option>
                @foreach (DepositoDto d in depositos)
                {
                    <option value="@d.Id_Deposito">@d.CodigoDeposito</option>
                }
            </InputSelect>

            @if (usaDestino)
            {
                <ValidationMessage For="@(() => modelo.Id_DepositoDestino)" />
            }
        </div>

        <!-- CANTIDAD -->
        <div class="mb-3">
            <label>Cantidad *</label>
            <InputNumber class="form-control"
                         @bind-Value="modelo.Cantidad"
                         disabled="@(Id != 0)" />
            <ValidationMessage For="@(() => modelo.Cantidad)" />
        </div>

        <!-- FECHA -->
        <div class="mb-3">
            <label>Fecha *</label>
            <InputDate class="form-control"
                       @bind-Value="modelo.Fecha"
                       disabled="@(Id != 0)" />
            <ValidationMessage For="@(() => modelo.Fecha)" />
        </div>

        <!-- BOTONES -->
        <div class="mt-3">
            @if (Id == 0)
            {
                <button class="btn btn-primary" disabled="@(!formValido)">
                    💾 Guardar
                </button>
            }

            <button class="btn btn-secondary ms-2" @onclick="Volver">
                ⬅ Volver
            </button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }

    </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private MovimientoMaterialDto modelo = new MovimientoMaterialDto();
    private EditContext editContext;

    private List<MaterialDto> materiales = new List<MaterialDto>();
    private List<DepositoDto> depositos = new List<DepositoDto>();

    private bool usaDestino = false;
    private bool formValido = false;
    private bool cargando = true;
    private string error = string.Empty;

    // 🔥 PROPIEDAD REACTIVA (SOLUCIÓN REAL)
    private string TipoSeleccionado
    {
        get => modelo.Tipo;
        set
        {
            modelo.Tipo = value;

            usaDestino = modelo.Tipo == "Ingreso/Egreso";

            if (!usaDestino)
            {
                modelo.Id_DepositoDestino = null;
            }

            Validar();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        HttpClient client = await AuthHttpClient.GetClient();

        materiales = await client.GetFromJsonAsync<List<MaterialDto>>("api/material")
            ?? new List<MaterialDto>();

        depositos = await client.GetFromJsonAsync<List<DepositoDto>>("api/deposito")
            ?? new List<DepositoDto>();

        if (Id != 0)
        {
            modelo = await client.GetFromJsonAsync<MovimientoMaterialDto>($"api/movimientos/{Id}")
                ?? new MovimientoMaterialDto();
        }
        else
        {
            modelo.Fecha = DateTime.Today;
        }

        usaDestino = modelo.Tipo == "Ingreso/Egreso";

        Configurar();

        cargando = false;
    }

    private void Configurar()
    {
        editContext = new EditContext(modelo);

        editContext.OnFieldChanged += (_, __) =>
        {
            Validar();
        };

        Validar();
    }

    private void Validar()
    {
        bool destinoValido = true;

        if (modelo.Tipo == "Ingreso/Egreso")
        {
            destinoValido =
                modelo.Id_DepositoDestino.HasValue &&
                modelo.Id_DepositoDestino.Value > 0;
        }

        formValido =
            !string.IsNullOrEmpty(modelo.CodigoMovimiento) &&
            !string.IsNullOrEmpty(modelo.Tipo) &&
            modelo.Id_Material > 0 &&
            modelo.Id_DepositoOrigen > 0 &&
            modelo.Cantidad > 0 &&
            modelo.Fecha != default &&
            destinoValido;

        StateHasChanged();
    }

    private async Task Guardar()
    {
        error = string.Empty;

        HttpClient client = await AuthHttpClient.GetClient();
        MovimientoMaterialDto? existe = await client.GetFromJsonAsync<MovimientoMaterialDto>($"api/movimientos/existe-codigo/{modelo.CodigoMovimiento}");

        if (existe != null)
        {
            error = "Ya existe un movimiento con ese código.";
            return;
        }

        string username = await ObtenerUsuarioActual();

        CrearMovimientoMaterialDto dto = new CrearMovimientoMaterialDto
        {
            IdMaterial = modelo.Id_Material,
            IdDepositoOrigen = modelo.Id_DepositoOrigen,
            IdDepositoDestino = modelo.Id_DepositoDestino,
            Tipo = modelo.Tipo,
            Cantidad = modelo.Cantidad,
            Fecha = modelo.Fecha,
            CodigoMovimiento = modelo.CodigoMovimiento,
            UserName = username
        };

        HttpResponseMessage response =
            await client.PostAsJsonAsync("api/movimientos", dto);

        if (!response.IsSuccessStatusCode)
        {
            error = "Error al guardar el movimiento.";
            return;
        }

        await JS.InvokeVoidAsync("alert",
            $"Movimiento {modelo.CodigoMovimiento} creado");

        Navigation.NavigateTo("/movimientos-material");
    }

    private async Task<string> ObtenerUsuarioActual()
    {
        AuthenticationState authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        ClaimsPrincipal user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            string? username =
                user.FindFirst("unique_name")?.Value ??
                user.FindFirst(ClaimTypes.Name)?.Value;

            return username ?? string.Empty;
        }

        return string.Empty;
    }

    private void Volver()
    {
        Navigation.NavigateTo("/movimientos-material");
    }

    // ================= DTOs =================

    public class CrearMovimientoMaterialDto
    {
        public int IdMaterial { get; set; }
        public int IdDepositoOrigen { get; set; }
        public int? IdDepositoDestino { get; set; }

        [Required(ErrorMessage = "El tipo es obligatorio")]
        public string Tipo { get; set; } = string.Empty;

        [Range(0.01, double.MaxValue, ErrorMessage = "Cantidad debe ser mayor a 0")]
        public double Cantidad { get; set; }

        [Required(ErrorMessage = "La fecha es obligatoria")]
        public DateTime Fecha { get; set; }

        [Required(ErrorMessage = "El código es obligatorio")]
        public string CodigoMovimiento { get; set; } = string.Empty;

        public string UserName { get; set; } = string.Empty;
    }

    public class MovimientoMaterialDto
    {
        public int Id_MovimientoMaterial { get; set; }
        public string CodigoMovimiento { get; set; } = string.Empty;
        public string Tipo { get; set; } = string.Empty;
        public double Cantidad { get; set; }
        public DateTime Fecha { get; set; }
        public int Id_Material { get; set; }
        public int Id_DepositoOrigen { get; set; }
        public int? Id_DepositoDestino { get; set; }
    }

    public class MaterialDto
    {
        public int Id_Material { get; set; }
        public string CodigoMaterial { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }

    public class DepositoDto
    {
        public int Id_Deposito { get; set; }
        public string CodigoDeposito { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
    }
}


