@page "/gestion-materiales"
@inject NavigationManager Navigation

<h1 class="page-title">Gestión de Materiales</h1>
<div class="dashboard-grid">
	<div class="dashboard-card" @onclick="IrMateriales">
		<div class="icon">📦</div>
		<div class="label">Materiales</div>
	</div>
	<div class="dashboard-card" @onclick="IrDepositos">
		<div class="icon">🏭</div>
		<div class="label">Depósitos</div>
	</div>
	<div class="dashboard-card" @onclick="IrUnidades">
		<div class="icon">📏</div>
		<div class="label">Unidades de Medida</div>
	</div>
	<div class="dashboard-card" @onclick="IrMovimientoMaterial">
		<div class="icon">🔄</div>
		<div class="label">Movimiento de Materiales</div>
	</div>
</div>
<h1 class="page-title">Reportes</h1>
<div class="dashboard-grid">
	<div class="dashboard-card" @onclick="IrSaldosMateriales">
		<div class="icon">📊</div>
		<div class="label">Saldos de Materiales</div>
	</div>
	<div class="dashboard-card">
		<div class="icon">📊 </div>
		<div class="label">Reporte 1</div>
	</div>
	<div class="dashboard-card">
		<div class="icon">📊 </div>
		<div class="label">Reporte 2</div>
	</div>
	<div class="dashboard-card">
		<div class="icon">📊 </div>
		<div class="label">Reporte 3</div>
	</div>
</div>


@code {
    void IrMateriales() => Navigation.NavigateTo("/materiales");
    void IrDepositos() => Navigation.NavigateTo("/depositos");
    void IrUnidades() => Navigation.NavigateTo("/unidades");
    void IrMovimientoMaterial() => Navigation.NavigateTo("/movimientos-material");
    void IrSaldosMateriales() => Navigation.NavigateTo("/saldos-materiales");
}
