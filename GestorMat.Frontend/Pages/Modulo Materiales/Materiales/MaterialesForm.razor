@page "/crear-material"
@page "/editar-material/{Id:int}"
@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation

<h1 class="page-title">@(Id == 0 ? "Crear Material" : "Editar Material")</h1>

@if (cargando)
{
    <div class="loading">
        <p>Cargando...</p>
    </div>
}
else
{
    <div class="form-container">
        <div class="card">
            <div class="card-body">
                <EditForm Model="modelo" OnSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label for="nombre">Nombre:</label>
                        <InputText id="nombre" class="form-control" @bind-Value="modelo.Nombre" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="text-danger" />
                    </div>

                    <div class="form-group">
                        <label for="precio">Precio:</label>
                        <InputNumber id="precio" class="form-control" @bind-Value="modelo.Precio" />
                        <ValidationMessage For="@(() => modelo.Precio)" class="text-danger" />
                    </div>

                    <div class="form-group">
                        <label for="unidad">Unidad de Medida:</label>
                        <select id="unidad" class="form-control" @bind="unidadMedidaSeleccionada">
                            <option value="0">-- Seleccionar --</option>
                            @foreach (UnidadDto u in unidades)
                            {
                                <option value="@u.Id">@u.Nombre (@u.Abreviatura)</option>
                            }
                        </select>
                        @if (unidadMedidaSeleccionada == 0 && !string.IsNullOrEmpty(error) && error.Contains("Unidad"))
                        {
                            <div class="text-danger">Debe seleccionar una unidad de medida</div>
                        }
                    </div>

                    <div class="button-group mt-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="icon">💾</span> @(Id == 0 ? "Crear" : "Actualizar")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="Volver">
                            <span class="icon">⬅️</span> Volver
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger mt-3">
                            @error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(exito))
                    {
                        <div class="alert alert-success mt-3">
                            @exito
                        </div>
                    }
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CrearMaterialDto modelo = new();
    private List<UnidadDto> unidades = new();
    private int unidadMedidaSeleccionada = 0;
    private bool cargando = false;
    private string error = string.Empty;
    private string exito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            List<UnidadDto>? data = await client.GetFromJsonAsync<List<UnidadDto>>("api/unidadmedida");
            unidades = data ?? new List<UnidadDto>();

            if (Id != 0)
            {
                // Cargar material existente para editar
                HttpResponseMessage response = await client.GetAsync($"api/material/{Id}");
                if (response.IsSuccessStatusCode)
                {
                    MaterialDto? material = await response.Content.ReadFromJsonAsync<MaterialDto>();
                    if (material != null)
                    {
                        modelo = new CrearMaterialDto
                        {
                            Nombre = material.Nombre,
                            Precio = material.Precio,
                            IdUnidadMedida = 0 // El ID de unidad se obtendría de otra forma
                        };
                        unidadMedidaSeleccionada = modelo.IdUnidadMedida;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            error = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Guardar()
    {
        error = string.Empty;
        exito = string.Empty;

        if (unidadMedidaSeleccionada == 0)
        {
            error = "Debe seleccionar una unidad de medida";
            return;
        }

        modelo.IdUnidadMedida = unidadMedidaSeleccionada;

        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            HttpResponseMessage response;

            if (Id == 0)
            {
                response = await client.PostAsJsonAsync("api/material", modelo);
                if (response.IsSuccessStatusCode)
                {
                    exito = "Material creado correctamente";
                }
            }
            else
            {
                response = await client.PutAsJsonAsync($"api/material/{Id}", modelo);
                if (response.IsSuccessStatusCode)
                {
                    exito = "Material actualizado correctamente";
                }
            }

            if (!response.IsSuccessStatusCode)
            {
                error = $"Error: {response.StatusCode}";
                return;
            }

            await Task.Delay(1500);
            Navigation.NavigateTo("/materiales");
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/materiales");
    }

    public class CrearMaterialDto
    {
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int IdUnidadMedida { get; set; }
    }

    public class MaterialDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public string UnidadMedida { get; set; } = string.Empty;
    }

    public class UnidadDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Abreviatura { get; set; } = string.Empty;
    }
}
