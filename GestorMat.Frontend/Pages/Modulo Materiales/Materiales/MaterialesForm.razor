@page "/crear-material"
@page "/editar-material/{Id:int}"

@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation

<h1 class="page-title">@(Id == 0 ? "Crear Material" : "Editar Material")</h1>

@if (cargando)
{
    <div class="loading">
        <p>Cargando...</p>
    </div>
}
else
{
    <div class="form-container">
        <div class="card">
            <div class="card-body">

                <EditForm EditContext="editContext" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- CÓDIGO -->
                    <div class="form-group">
                        <label>Código</label>
                        <InputText class="form-control" @bind-Value="modelo.CodigoMaterial" />
                    </div>

                    <!-- NOMBRE -->
                    <div class="form-group">
                        <label>Nombre</label>
                        <InputText class="form-control" @bind-Value="modelo.Nombre" />
                    </div>

                    <!-- DESCRIPCION -->
                    <div class="form-group">
                        <label>Descripción</label>
                        <InputTextArea class="form-control" @bind-Value="modelo.Descripcion" rows="3" />
                    </div>

                    <!-- PRECIO -->
                    <div class="form-group">
                        <label>Precio</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Precio" />
                    </div>

                    <!-- UNIDAD -->
                    <div class="form-group">
                        <label for="idUnidadMedida">Unidad de Medida</label>
                        <InputSelect id="idUnidadMedida" class="form-control" @bind-Value="modelo.Id_UnidadMedida">
                            <option value="0">-- Seleccionar Unidad de Medida --</option>
                            @foreach (var u in unidades)
                            {
                                <option value="@u.Id_UnidadMedida">@u.Nombre (@u.Abreviatura)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => modelo.Id_UnidadMedida)" class="text-danger" />
                    </div>

                    <!-- STOCK MINIMO -->
                    <div class="form-group">
                        <label>Stock mínimo</label>
                        <InputNumber class="form-control" @bind-Value="modelo.StockMinimo" />
                    </div>

                    <!-- PERMITE STOCK NEGATIVO -->
                    <div class="form-group">
                        <label>
                            <InputCheckbox @bind-Value="modelo.PermiteStockNegativo" />
                            Permite stock negativo
                        </label>
                    </div>

                    <!-- ACTIVO -->
                    <div class="form-group">
                        <label>
                            <InputCheckbox @bind-Value="modelo.Activo" />
                            Activo
                        </label>
                    </div>

                    <!-- BOTONES -->
                    <div class="button-group mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@(!formValido)">
                            💾 @(Id == 0 ? "Crear" : "Actualizar")
                        </button>

                        <button type="button" class="btn btn-secondary" @onclick="Volver">
                            ⬅ Volver
                        </button>
                    </div>

                    <!-- MENSAJES -->
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger mt-3">@error</div>
                    }

                    @if (!string.IsNullOrEmpty(exito))
                    {
                        <div class="alert alert-success mt-3">@exito</div>
                    }

                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CrearMaterialDto modelo = new();
    private List<UnidadMedidaDto> unidades = new();

    private EditContext editContext;
    private bool formValido = false;

    private bool cargando = false;
    private string error = string.Empty;
    private string exito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;

        try
        {
            var client = await AuthHttpClient.GetClient();

            unidades = await client.GetFromJsonAsync<List<UnidadMedidaDto>>("api/unidadmedida")
                       ?? new List<UnidadMedidaDto>();

            if (Id != 0)
            {
                var material = await client.GetFromJsonAsync<MaterialDto>($"api/material/{Id}");

                if (material != null)
                {
                    modelo = new CrearMaterialDto
                    {
                        CodigoMaterial = material.CodigoMaterial,
                        Nombre = material.Nombre,
                        Descripcion = material.Descripcion,
                        Precio = material.Precio,
                        Id_UnidadMedida = material.Id_UnidadMedida,
                        StockMinimo = material.StockMinimo,
                        PermiteStockNegativo = material.PermiteStockNegativo,
                        Activo = material.Activo
                    };
                }
            }
            else
            {
                modelo = new CrearMaterialDto
                {
                    Activo = true,
                    PermiteStockNegativo = false
                };
            }

            ConfigurarEditContext();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void ConfigurarEditContext()
    {
        editContext = new EditContext(modelo);

        formValido = editContext.Validate();

        editContext.OnValidationStateChanged += (sender, args) =>
        {
            formValido = !editContext.GetValidationMessages().Any();
            StateHasChanged();
        };
    }

    private async Task Guardar()
    {
        error = string.Empty;
        exito = string.Empty;

        if (modelo.Id_UnidadMedida <= 0)
        {
            error = "Debe seleccionar una unidad de medida válida";
            return;
        }

        try
        {
            var client = await AuthHttpClient.GetClient();
            HttpResponseMessage response;

            if (Id == 0)
                response = await client.PostAsJsonAsync("api/material", modelo);
            else
                response = await client.PutAsJsonAsync($"api/material/{Id}", modelo);

            if (!response.IsSuccessStatusCode)
            {
                error = $"Error: {response.StatusCode}";
                return;
            }

            exito = Id == 0 ? "Material creado correctamente" : "Material actualizado correctamente";

            await Task.Delay(1200);
            Navigation.NavigateTo("/materiales");
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/materiales");
    }
}



