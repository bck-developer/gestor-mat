@page "/materiales"
@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1 class="page-title">Materiales</h1>

<div class="button-group mb-3">
    <button class="btn btn-primary" @onclick="IrCrear">
        ➕ Nuevo Material
    </button>

    <button class="btn btn-secondary" @onclick="Recargar">
        🔄 Recargar
    </button>

    <button class="btn btn-success" @onclick="DescargarPlantilla" disabled="@descargando">
        @(descargando ? "Descargando..." : "📥 Plantilla Excel")
    </button>

    <label class="btn btn-outline-primary">
        📤 Cargar Excel
        <InputFile OnChange="SubirExcel" hidden />
    </label>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(tipoMensaje == "success" ? "alert-success" : "alert-danger")">
        @((MarkupString)mensaje)
    </div>
}

@if (cargando)
{
    <div class="loading">
        <p>Cargando materiales...</p>
    </div>
}
else if (string.IsNullOrEmpty(error))
{
    @if (cargandoArchivo)
    {
        <div class="loading mt-2">
            <p>Procesando archivo...</p>
        </div>
    }

    @if (materiales.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Unidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MaterialDto mat in materiales)
                    {
                        <tr>
                            <td>@mat.Nombre</td>
                            <td>$@mat.Precio.ToString("N2")</td>
                            <td>@mat.UnidadMedida</td>
                            <td>
                                <div class="action-buttons-inline">
                                    <button class="btn btn-sm btn-warning" @onclick="() => IrEditar(mat.Id_Material)" title="Editar material">
                                        ✏️ Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger btn-outline" @onclick="() => ConfirmarEliminar(mat.Id_Material, mat.Nombre)" title="Eliminar definitivamente">
                                        🗑️ Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p>No hay materiales registrados. <a href="/crear-material">Crea uno aquí</a></p>
        </div>
    }
}
else
{
    <div class="alert alert-danger" role="alert">
        <p>@error</p>
        <button class="btn btn-secondary" @onclick="Recargar">Reintentar</button>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h5>Confirmar Eliminación</h5>
                <button type="button" class="close" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar el material "<strong>@materialAEliminarNombre</strong>"?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                <button class="btn btn-danger" @onclick="EliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialDto> materiales = new();
    private bool cargando = true;
    private string error = string.Empty;
    private bool descargando = false;
    private bool cargandoArchivo = false;
    private string mensaje = string.Empty;
    private string tipoMensaje = string.Empty;
    private bool mostrarConfirmacion = false;
    private int materialAEliminarId;
    private string materialAEliminarNombre = string.Empty;

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        cargando = true;
        error = string.Empty;
        materiales = new();

        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            List<MaterialDto>? data = await client.GetFromJsonAsync<List<MaterialDto>>("api/material");
            materiales = data ?? new List<MaterialDto>();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar materiales: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrCrear() => Navigation.NavigateTo("/crear-material");
    private void IrEditar(int id) => Navigation.NavigateTo($"/editar-material/{id}");

    private void ConfirmarEliminar(int id, string nombre)
    {
        materialAEliminarId = id;
        materialAEliminarNombre = nombre;
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar() => mostrarConfirmacion = false;

    private async Task EliminarConfirmado()
    {
        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            await client.DeleteAsync($"api/material/{materialAEliminarId}");
            mostrarConfirmacion = false;
            await Recargar();
        }
        catch (Exception ex)
        {
            error = $"Error al eliminar material: {ex.Message}";
        }
    }

    private async Task DescargarPlantilla()
    {
        try
        {
            descargando = true;

            HttpClient client = await AuthHttpClient.GetClient();
            HttpResponseMessage response = await client.GetAsync("api/material/plantilla", HttpCompletionOption.ResponseHeadersRead);

            response.EnsureSuccessStatusCode();

            Stream stream = await response.Content.ReadAsStreamAsync();

            using MemoryStream ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/download.js");

            await module.InvokeVoidAsync(
                "downloadFileFromStream",
                "PlantillaMateriales.xlsx",
                ms.ToArray()
            );
        }
        catch (Exception ex)
        {
            mensaje = $"Error al descargar: {ex.Message}";
            tipoMensaje = "error";
        }
        finally
        {
            descargando = false;
        }
    }

    private async Task SubirExcel(InputFileChangeEventArgs e)
    {
        mensaje = string.Empty;

        try
        {
            var file = e.File;

            if (!file.Name.EndsWith(".xlsx"))
            {
                mensaje = "Archivo inválido. Solo .xlsx";
                tipoMensaje = "error";
                return;
            }

            cargandoArchivo = true;

            MultipartFormDataContent content = new MultipartFormDataContent();
            content.Add(new StreamContent(file.OpenReadStream()), "file", file.Name);

            HttpClient client = await AuthHttpClient.GetClient();
            HttpResponseMessage response = await client.PostAsync("api/material/importar", content);

            MaterialImportResultDto? result = await response.Content.ReadFromJsonAsync<MaterialImportResultDto>();

            if (result != null)
            {
                mensaje = $"✔ {result.Exitosos} cargados | ❌ {result.Fallidos} errores";

                if (result.Errores.Any())
                {
                    mensaje += "<br/><br/>";
                    mensaje += string.Join("<br/>",
                        result.Errores.Select(e => $"Fila {e.Fila}: {e.Mensaje}"));
                }

                tipoMensaje = result.Fallidos > 0 ? "error" : "success";

                await Recargar();
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            tipoMensaje = "error";
        }
        finally
        {
            cargandoArchivo = false;
        }
    }
}