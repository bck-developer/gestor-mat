@page "/unidades"
@inject GestorMat.Frontend.Services.AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation

<h1 class="page-title">Unidades de Medida</h1>

<div class="button-group mb-3">
    <button class="btn btn-primary" @onclick="IrCrear">
        <span class="icon">➕</span> Nueva Unidad
    </button>
    <button class="btn btn-secondary" @onclick="Recargar">
        <span class="icon">🔄</span> Recargar
    </button>
</div>

@if (cargando)
{
    <div class="loading">
        <p>Cargando unidades...</p>
    </div>
}
else if (string.IsNullOrEmpty(error))
{
    @if (unidades != null && unidades.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Abreviatura</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (UnidadDto u in unidades)
                    {
                        <tr>
                            <td>@u.Nombre</td>
                            <td>@u.Abreviatura</td>
                            <td>
                                <div class="action-buttons-inline">
                                    <button class="btn btn-sm btn-warning" @onclick="() => IrEditar(u.Id)" title="Editar unidad">
                                        ✏️ Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger btn-outline" @onclick="() => ConfirmarEliminar(u.Id, u.Nombre)" title="Eliminar definitivamente">
                                        🗑️ Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p>No hay unidades registradas. <a href="/crear-unidad">Crea una aquí</a></p>
        </div>
    }
}
else
{
    <div class="alert alert-danger" role="alert">
        <p>@error</p>
        <button class="btn btn-secondary" @onclick="Recargar">Reintentar</button>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal-content" @onclick:stopPropagation>
            <div class="modal-header">
                <h5>Confirmar Eliminación</h5>
                <button type="button" class="close" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar la unidad "<strong>@unidadAEliminarNombre</strong>"?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                <button class="btn btn-danger" @onclick="EliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<UnidadDto> unidades = new();
    private bool cargando = true;
    private string error = string.Empty;
    private bool mostrarConfirmacion = false;
    private int unidadAEliminarId;
    private string unidadAEliminarNombre = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Recargar();
    }

    private async Task Recargar()
    {
        cargando = true;
        error = string.Empty;
        unidades = new();

        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            List<UnidadDto>? data = await client.GetFromJsonAsync<List<UnidadDto>>("api/unidadmedida");
            unidades = data ?? new List<UnidadDto>();
        }
        catch (Exception ex)
        {
            error = $"Error al cargar unidades: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IrCrear() => Navigation.NavigateTo("/crear-unidad");

    private void IrEditar(int id) => Navigation.NavigateTo($"/editar-unidad/{id}");

    private void ConfirmarEliminar(int id, string nombre)
    {
        unidadAEliminarId = id;
        unidadAEliminarNombre = nombre;
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task EliminarConfirmado()
    {
        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            await client.DeleteAsync($"api/unidadmedida/{unidadAEliminarId}");
            mostrarConfirmacion = false;
            await Recargar();
        }
        catch (Exception ex)
        {
            error = $"Error al eliminar unidad: {ex.Message}";
        }
    }

    public class UnidadDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Abreviatura { get; set; } = string.Empty;
    }
}
