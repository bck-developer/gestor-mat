@page "/crear-unidad"
@page "/editar-unidad/{Id:int}"
@inject AuthHttpClient AuthHttpClient
@inject NavigationManager Navigation

<h1 class="page-title">@(Id == 0 ? "Crear Unidad de Medida" : "Editar Unidad de Medida")</h1>

@if (cargando)
{
    <div class="loading">
        <p>Cargando...</p>
    </div>
}
else
{
    <div class="form-container">
        <div class="card">
            <div class="card-body">
                <EditForm Model="modelo" OnSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label for="nombre">Nombre:</label>
                        <InputText id="nombre" class="form-control" @bind-Value="modelo.Nombre" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="text-danger" />
                    </div>

                    <div class="form-group">
                        <label for="abreviatura">Abreviatura:</label>
                        <InputText id="abreviatura" class="form-control" @bind-Value="modelo.Abreviatura" maxlength="10" />
                        <ValidationMessage For="@(() => modelo.Abreviatura)" class="text-danger" />
                    </div>

                    <div class="button-group mt-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="icon">💾</span> @(Id == 0 ? "Crear" : "Actualizar")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="Volver">
                            <span class="icon">⬅️</span> Volver
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger mt-3">
                            @error
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(exito))
                    {
                        <div class="alert alert-success mt-3">
                            @exito
                        </div>
                    }
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CrearUnidadDto modelo = new();
    private bool cargando = false;
    private string error = string.Empty;
    private string exito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Id != 0)
        {
            cargando = true;
            try
            {
                HttpClient client = await AuthHttpClient.GetClient();
                UnidadDto? unidad = await client.GetFromJsonAsync<UnidadDto>($"api/unidadmedida/{Id}");
                if (unidad != null)
                {
                    modelo = new CrearUnidadDto
                    {
                        Nombre = unidad.Nombre,
                        Abreviatura = unidad.Abreviatura
                    };
                }
                else
                {
                    error = "Unidad no encontrada";
                }
            }
            catch (Exception ex)
            {
                error = $"Error al cargar la unidad: {ex.Message}";
            }
            finally
            {
                cargando = false;
            }
        }
    }

    private async Task Guardar()
    {
        error = string.Empty;
        exito = string.Empty;

        try
        {
            HttpClient client = await AuthHttpClient.GetClient();
            HttpResponseMessage response;

            if (Id == 0)
            {
                response = await client.PostAsJsonAsync("api/unidadmedida", modelo);
                if (response.IsSuccessStatusCode)
                {
                    exito = "Unidad creada correctamente";
                }
            }
            else
            {
                response = await client.PutAsJsonAsync($"api/unidadmedida/{Id}", modelo);
                if (response.IsSuccessStatusCode)
                {
                    exito = "Unidad actualizada correctamente";
                }
            }

            if (!response.IsSuccessStatusCode)
            {
                error = $"Error: {response.StatusCode}";
                return;
            }

            await Task.Delay(1500);
            Navigation.NavigateTo("/unidades");
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/unidades");
    }

    public class CrearUnidadDto
    {
        public string Nombre { get; set; } = string.Empty;
        public string Abreviatura { get; set; } = string.Empty;
    }

    public class UnidadDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Abreviatura { get; set; } = string.Empty;
    }
}
