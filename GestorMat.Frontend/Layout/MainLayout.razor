@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject GestorMat.Frontend.Services.AuthService AuthService
@inject GestorMat.Frontend.Services.NavigationService NavService
@inject NavigationManager Navigation

<header class="app-header">
    <div class="header-container">

        <!-- IZQUIERDA -->
        <div class="header-left">
            <div class="brand">GestorMat</div>

            @if (MostrarVolver())
            {
                <button class="btn btn-secondary btn-sm" @onclick="NavService.SubirNivel">
                    ⬅️ Volver
                </button>
            }
        </div>

        <!-- CENTRO -->
        <div class="header-center">
            <span class="breadcrumb-text">
                @for (int i = 0; i < breadcrumbs.Count; i++)
                {
                    <span>@breadcrumbs[i]</span>
                    @if (i < breadcrumbs.Count - 1)
                    {
                        <span> &gt; </span>
                    }
                }
            </span>
        </div>

        <!-- DERECHA -->
        <div class="header-right">
            <AuthorizeView>
                <Authorized>
                    <div class="user-info">
                        <span class="user-icon">👤</span>
                        <span class="user-name">@usuario</span>
                        <span class="user-role">(@rol)</span>
                    </div>

                    <button class="btn-logout" @onclick="Logout">
                        🚪 Salir
                    </button>
                </Authorized>

                <NotAuthorized>
                    <span class="not-auth">No autenticado</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</header>

<div class="main-content">
    @Body
</div>

@code {
    private string usuario = "";
    private string rol = "";
    private bool logueado = false;
    private List<string> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuario();
        InicializarNavegacion();
    }

    private async Task CargarUsuario()
    {
        logueado = await AuthService.EstaLogueado();

        if (logueado)
        {
            var datos = await AuthService.ObtenerDatosUsuario();
            usuario = datos.usuario;
            rol = datos.rol;
        }
    }

    private void InicializarNavegacion()
    {
        ActualizarUI();
        Navigation.LocationChanged += (_, __) => ActualizarUI();
    }

    private void ActualizarUI()
    {
        breadcrumbs = NavService.ObtenerBreadcrumb();
        StateHasChanged();
    }

    private bool MostrarVolver()
    {
        var ruta = NavService.GetCurrentRoute();

        return logueado &&
               !string.IsNullOrEmpty(ruta) &&
               !ruta.Contains("login");
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }
}